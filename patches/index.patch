+// ---------- RANK PVP (todos os players do servidor) ----------
+const RANK_PVP_URL = "https://raw.githubusercontent.com/FlynMael/aorus-xp-tracker/main/data/pvp_rank.json";
+let rankPvpData = null;
+let rankPvpSub = "geral";
+let rankPvpMetric = "kills";
+
+async function fetchRankPvp(){
+  try{
+    const res = await fetch(RANK_PVP_URL, { cache: "no-store" });
+    rankPvpData = res.ok ? await res.json() : null;
+  }catch(err){
+    rankPvpData = null;
+  }
+  renderRankPvp();
+}
+
+function renderRankPvp(){
+  const el = document.getElementById("rankpvp-list");
+  document.querySelectorAll("#rankpvp-sub .range-btn").forEach(b => b.classList.toggle("active", b.dataset.sub === rankPvpSub));
+  document.querySelectorAll("#rankpvp-metric .range-btn").forEach(b => b.classList.toggle("active", b.dataset.metric === rankPvpMetric));
+  document.getElementById("rankpvp-dia-controls").style.display = rankPvpSub === "dia" ? "block" : "none";
+
+  if(!rankPvpData){
+    el.innerHTML = `<div class="empty">Rank ainda não coletado. Volta em instantes.</div>`;
+    return;
+  }
+  const today = localISODate(new Date());
+  let rows;
+  if(rankPvpSub === "geral"){
+    rows = rankPvpData.geral || [];
+  }else{
+    rows = rankPvpData.day === today ? (rankPvpMetric === "kills" ? rankPvpData.dia_kills : rankPvpData.dia_xp) || [] : [];
+  }
+  if(rows.length === 0){
+    el.innerHTML = `<div class="empty">${rankPvpSub === "geral" ? "Sem dados." : "Ninguém pontuou hoje ainda."}</div>`;
+    return;
+  }
+  const mono = "font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--text-muted);";
+  el.innerHTML = rows.map((r,i) => {
+    let main, sub;
+    if(rankPvpSub === "geral"){
+      main = `${Number(r.battleEXP).toLocaleString("pt-BR")} XP`;
+      sub = `${r.kills} kills`;
+    }else if(rankPvpMetric === "kills"){
+      main = `+${r.killsDia} kills`;
+      sub = `${r.xpDia >= 0 ? "+" : ""}${Number(r.xpDia).toLocaleString("pt-BR")} XP`;
+    }else{
+      main = `+${Number(r.xpDia).toLocaleString("pt-BR")} XP`;
+      sub = `${r.killsDia >= 0 ? "+" : ""}${r.killsDia} kills`;
+    }
+    const tracked = TRACKED_PLAYERS.some(n => n.toLowerCase() === String(r.name).toLowerCase());
+    return `
+    <div class="rank-row">
+      <div class="rank-num">${i+1}</div>
+      <div class="rank-name">${tracked ? "⭐ " : ""}${esc(r.name)}<div style="${mono}">${esc(r.clan)} · Lv ${esc(r.level)}</div></div>
+      <div style="text-align:right;">
+        <div class="rank-gain">${main}</div>
+        <div style="${mono}">${sub}</div>
+      </div>
+    </div>`;
+  }).join("");
+}
+
+document.querySelectorAll("#rankpvp-sub .range-btn").forEach(btn => {
+  btn.addEventListener("click", () => { rankPvpSub = btn.dataset.sub; renderRankPvp(); });
+});
+document.querySelectorAll("#rankpvp-metric .range-btn").forEach(btn => {
+  btn.addEventListener("click", () => { rankPvpMetric = btn.dataset.metric; renderRankPvp(); });
+});
